{
  "name": "@philogicae/docs_ui",
  "description": "Docs UI for Telegram Agent",
  "version": "1.0.0",
  "repository": "https://github.com/philogicae/telegram-agent-mcp-client/docs_ui",
  "private": true,
  "author": "@philogicae",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 4040 --turbo",
    "lint": "biome check --write app --unsafe",
    "build": "next build --turbo",
    "start": "next start -H 0.0.0.0 -p 4040",
    "upgrade": "pnpm update && pnpm prune",
    "clean": "rimraf .next && rimraf out && rimraf node_modules && pnpm install",
    "repomix": "pnpx repomix --style markdown --remove-empty-lines"
  },
  "dependencies": {
    "@heroui/react": "^3.2.3",
    "@heroui/styles": "^3.2.3",
    "@tanstack/react-query": "^5.101.4",
    "dompurify": "^3.4.13",
    "html2pdf.js": "^0.14.0",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "clsx": "^2.1.1",
    "postcss": "^8.5.25",
    "serve": "^14.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
