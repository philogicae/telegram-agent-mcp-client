{
  "description": "Specialized news search via Brave Search for current events, ideal for gathering news and articles about recent developments and broad information gathering.",
  // Free: 2000 queries by month. Create API KEY: https://brave.com/search/api/
  "command": "npx -y @brave/brave-search-mcp-server",
  "env": {
    "BRAVE_API_KEY": "{ENV:BRAVE_API_KEY}"
  },
  "enable": ["brave_news_search"],
  "edit": {
    "brave_news_search": {
      "name": "news_search"
    }
  }
}
