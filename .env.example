# Model env vars accept capability suffixes: <model_code>|<option1>[+<option2>]
# Options: text (text in/out) vision (images in) stt (audio in) video (video in)
#          pdf (PDF in) image (image gen) tts (speech out) structured (native JSON)
# Lookup: https://models.dev
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-3.8-flash|text+vision+stt+video+pdf+structured
GEMINI_API_MODEL_SMALL=gemini-3.5-flash-lite|text+vision+stt+video+pdf+structured
GEMINI_API_IMAGE_MODEL=gemini-3.1-flash-lite-image|text+vision+image
# Fireworks
FIREWORKS_API_KEY=
FIREWORKS_API_MODEL=accounts/fireworks/routers/kimi-k2p6-turbo|text+vision
# Opencode
OPENCODE_API_KEY=
OPENCODE_API_MODEL=deepseek-v4-flash|text+structured
OPENCODE_API_MODEL_ALT=omen-alpha|text+vision+structured
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_TTS_MODEL=x-ai/grok-voice-tts-1.0|tts
OPENROUTER_TTS_VOICE=eve
OPENROUTER_TTS_SPEED=1.15
# Ollama
OLLAMA_API_BASE=
OLLAMA_API_MODEL=huihui_ai/qwen3-abliterated:0.6b|text
# OpenRouter
OPENROUTER_API_KEY=
# Provider run order: first CONFIGURED provider wins; with a required
# capability, first capable provider in the list is selected.
LLM_ORDER=opencode-alt,opencode,gemini,gemini-small,openrouter-tts,fireworks,ollama
LLM_ORDER_FAST=opencode-alt,opencode,gemini-small,gemini,openrouter-tts,fireworks,ollama
# Runtime failover: each failed call counts a strike and cools the provider
# down; after N strikes it is jailed for H hours (released automatically).
# LLM_DEAD_COOLDOWN=300
# LLM_JAIL_STRIKES=3
# LLM_JAIL_HOURS=24

#----- Langchain -----
LANGSMITH_PROJECT=telegram-agent-mcp-client
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
GRPC_VERBOSITY=NONE

#----- MCP Tools -----
DATA_DIR=
CONFIG_DIR=
FILESYSTEM_WORKSPACE=
RAG_SERVER_URL=http://127.0.0.1:8802
TORRENT_CLIENT_URL=http://127.0.0.1:8006
TORRENT_SEARCH_URL=http://127.0.0.1:8005
DEEP_SEARCH_API_KEY=
BRAVE_API_KEY=
SEARXNG_BASE_URL=http://127.0.0.1
SEARXNG_PORT=6734
SEARXNG_CONFIG=
SEARXNG_SECRET=
SCRAPLING_BASE_URL=http://127.0.0.1
OPENCODE_ACP_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=
OPENCODE_SERVER_PASSWORD=
# Web UI base URL to build clickable session links (e.g. https://ocw.rphi.xyz).
# Leave empty to omit session links from results and progress panels.
OPENCODE_WEB_URL=
# Session-call timeout in seconds (default 600 = 10 min). On timeout the tool
# returns a `timeout` marker (not an error) — the run keeps going server-side,
# re-attach with watch_dev_session.
OPENCODE_SERVER_TIMEOUT=600
# Maximum assistant text returned to the caller before truncation (default 20000)
OPENCODE_SERVER_MAX_OUTPUT=20000
# Live progress polling: interval in seconds and lines shown on the chat panel
OPENCODE_SERVER_PROGRESS_POLL=3
OPENCODE_SERVER_PROGRESS_LINES=6
# Max sessions kept in the local JSONL cache (default 100, newest kept)
OPENCODE_SERVER_MAX_CACHED_SESSIONS=100
# Extract in-browser from request headers x-betaseries-key/x-betaseries-token
BETASERIES_API_KEY_TOKEN=
BETASERIES_USERNAME=
KANEO_URL=
KANEO_API_KEY=

#----- Telegram -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_DEV=
TELEGRAM_CHAT_DEV=
AGENT_RELAY_TOKEN=
AGENT_RELAY_PORT=4041

#----- Misc -----
#TZ=Europe/Bucharest
#DOCKER_HOST=
#TRANSMISSION_ENABLE=1
#TRANSMISSION_URL=http://127.0.0.1:9091
#TRANSMISSION_USER=
#TRANSMISSION_PASS=
#TRANSMISSION_DOWNLOAD_DIR=
#MEDIA_LIB_REFRESH=<api-endpoint-url>
#RAG_URL=
#DOCS_UI_URL=