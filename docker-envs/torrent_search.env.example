# Whether to include magnet links in the mcp.search_torrents()/mcp.popular_torrents() results (thepiratebay.org, nyaa.si, 1337x.to, yts.mx, apibay.org, eztvx.to, fitgirl-repacks.site, subsplease.org, bittorrented.com, uindex.org).
# If unset, defaults to 'false' to greatly reduce token usage.
#INCLUDE_LINKS=true

# Comma-separated list of sources to exclude from the mcp.search_torrents() results.
#EXCLUDE_SOURCES=nyaa.si

# Seconds of inactivity before the headless browser used for HTML sources is
# shut down (it restarts automatically on the next search). Default: 120.
#CRAWLER_IDLE_TIMEOUT=120